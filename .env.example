APP_ENV=development
DATABASE_URL=sqlite:///./signalgraph.db
SIGNALGRAPH_MOCK_MODE=true
SIGNALGRAPH_SCAN_PHASE_TIMEOUT_SECONDS=300

# Bright Data REST API
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_API_ENDPOINT=https://api.brightdata.com/request
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# Bright Data Browser API
BRIGHT_DATA_BROWSER_WS=
BRIGHT_DATA_BROWSER_SELENIUM_URL=

# Bright Data MCP
BRIGHT_DATA_MCP_URL=

# AI/ML API
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_EXTRACTION_MODEL=openai/gpt-4o-mini
AIML_BRIEFING_MODEL=openai/gpt-4o
AIML_DRAFT_MODEL=openai/gpt-4o-mini

# Featherless AI (optional; useful for open-model ranking/extraction)
# Used by the media engine as the cheap model for source ranking and
# transcript-chunk relevance filtering before the stronger AIMLAPI extraction.
FEATHERLESS_API_KEY=
FEATHERLESS_API_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_RANKING_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Multimodal signal engine (media scans)
MEDIA_SCAN_MAX_SOURCES=3
MEDIA_SCAN_PHASE_TIMEOUT_SECONDS=600
# When false (default), raw transcripts are dropped after PII scrubbing and
# only scrubbed text + structured signals are retained.
MEDIA_TRANSCRIPT_RETENTION_RAW=false
SPEECHMATICS_POLL_SECONDS=10
SPEECHMATICS_MAX_POLL_ATTEMPTS=60

# Cognee
COGNEE_API_KEY=
COGNEE_API_URL=
COGNEE_TENANT_ID=
COGNEE_USER_ID=
COGNEE_DATASET_PREFIX=signalgraph
COGNEE_OPERATION_TIMEOUT_SECONDS=20

# Memory backend selector. "jsonl" (default) writes to var/memory/.
# "cognee" writes graph/vector memory through hosted Cognee.
TENDRIL_MEMORY_BACKEND=jsonl

# Optional integrations
TRIGGERWARE_API_KEY=
SPEECHMATICS_API_KEY=

# CORS
# Comma-separated list of allowed origins. Add Vercel preview/prod domains here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex to allow rotating Vercel preview URLs. Leave empty in dev.
# Example: ^https://.*\.vercel\.app$
CORS_ALLOW_ORIGIN_REGEX=
