APP_ENV=development
DATABASE_URL=sqlite:///./signalgraph.db
SIGNALGRAPH_MOCK_MODE=true
SIGNALGRAPH_SCAN_PHASE_TIMEOUT_SECONDS=300

# Bright Data REST API
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_API_ENDPOINT=https://api.brightdata.com/request
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# Bright Data Browser API
BRIGHT_DATA_BROWSER_WS=
BRIGHT_DATA_BROWSER_SELENIUM_URL=

# Bright Data MCP
BRIGHT_DATA_MCP_URL=

# AI/ML API
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_EXTRACTION_MODEL=openai/gpt-4o-mini
AIML_BRIEFING_MODEL=openai/gpt-4o
AIML_DRAFT_MODEL=openai/gpt-4o-mini

# Cognee
COGNEE_API_KEY=
COGNEE_API_URL=
COGNEE_DATASET_PREFIX=signalgraph
DATA_ROOT_DIRECTORY=backend/var/cognee/data
SYSTEM_ROOT_DIRECTORY=backend/var/cognee/system
CACHE_ROOT_DIRECTORY=backend/var/cognee/cache
COGNEE_LOGS_DIR=backend/var/cognee/logs
COGNEE_OPERATION_TIMEOUT_SECONDS=20
ENABLE_BACKEND_ACCESS_CONTROL=false
CACHING=false
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_ENDPOINT=https://api.aimlapi.com/v1
LLM_API_KEY=

# Memory backend selector. "jsonl" (default) writes to var/memory/.
# "cognee" writes graph/vector memory through local Cognee.
TENDRIL_MEMORY_BACKEND=jsonl

# Optional integrations
TRIGGERWARE_API_KEY=
SPEECHMATICS_API_KEY=

# CORS
# Comma-separated list of allowed origins. Add Vercel preview/prod domains here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex to allow rotating Vercel preview URLs. Leave empty in dev.
# Example: ^https://.*\.vercel\.app$
CORS_ALLOW_ORIGIN_REGEX=
